---
import ShellLayout from '@brainage04/astro-shell/components/SiteLayout.astro';
import { siteConfig } from '../site.config';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
---

<ShellLayout
  title={title}
  siteName={siteConfig.name}
  description={description}
  navItems={siteConfig.navItems}
  sourceHref={siteConfig.sourceUrl}
  ownerHref={siteConfig.ownerUrl}
  ownerName={siteConfig.ownerName}
>
  <slot />
</ShellLayout>
