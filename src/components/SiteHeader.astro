---
import { siteConfig } from '../site.config';

const basePath = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const withBase = (href: string) => {
  if (href.startsWith('http') || href.startsWith('mailto:')) return href;
  if (href.startsWith('#')) return href;

  const [path = '/', hash = ''] = href.split('#');
  const normalizedBase = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
  const normalizedPath = path.startsWith('/') ? path : `/${path}`;
  const fullPath = normalizedPath === '/' ? basePath : `${normalizedBase}${normalizedPath}`;

  return hash ? `${fullPath}#${hash}` : fullPath;
};

const isActive = (href: string) => {
  if (href.includes('#') || href.startsWith('http') || href.startsWith('mailto:')) return false;

  const targetPath = withBase(href).replace(/\/$/, '') || '/';

  return currentPath === targetPath;
};
---

<header class="site-header">
  <nav aria-label="Primary navigation">
    <div class="nav-links">
      {siteConfig.navItems.map((item) => (
        <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} data-active={isActive(item.href) ? 'true' : undefined}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--background0) 90%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid color-mix(in srgb, var(--foreground2) 45%, transparent);
  }

  nav {
    width: min(100% - 1.5rem, var(--site-width));
    margin-inline: auto;
    display: flex;
    justify-content: center;
    padding-block: clamp(0.65rem, 1.4vw, 0.85rem);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1.55rem, 4vw, 2.7rem);
    align-items: center;
    justify-content: center;
  }

  .nav-links a {
    color: var(--foreground1);
    text-decoration: none;
    border-block-end: 2px solid transparent;
    padding-block: 0.2rem;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a[data-active='true'] {
    color: var(--foreground0);
    border-block-end-color: var(--accent-cyan);
  }

  @media (max-width: 520px) {
    nav {
      align-items: flex-start;
    }

    .nav-links {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
